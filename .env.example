# ============================================================
# senbi-auto 환경변수
#   cp .env.example .env  후 값을 채우세요.
# 대부분의 설정은 대시보드에서 바꿀 수 있고, 여기 값은 초기 기본값입니다.
# ============================================================

# Claude API 키 (필수) — 글 생성·이웃 문구 생성에 사용
# https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=

# 데이터 저장 폴더 (선택) — 세션·설정·이미지 캐시가 저장됩니다.
# 비워두면 사용자 홈의 ~/.senbi-auto 를 씁니다.
SENBI_AUTO_DATA_DIR=

# 로컬 대시보드 포트 (선택, 기본 3060)
SENBI_AUTO_PORT=3060
